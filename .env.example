# Copia a .env para el arranque local con docker compose. En Coolify se ponen en la UI.
POSTGRES_USER=jav
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=jav
# Puerto publicado en este PC (sólo lo usa docker-compose.override.yml)
APP_PORT=3000

# Sólo en este PC (Norton intercepta TLS): false. Nunca en producción.
NPM_STRICT_SSL=true
