{
  "name": "just-another-vtt",
  "version": "1.0.0",
  "description": "Mesa virtual para rol: iluminación dinámica, escenas, tiempo real y PostgreSQL",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-include=\"modules/tablero3d/*.js\" --test-coverage-lines=78 --test-coverage-branches=72 --test-coverage-functions=82 \"test/*.test.js\" \"test/t3d/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "test:e2e": "node test/e2e/realtime.mjs",
    "test:ui": "node test/e2e/ui.mjs",
    "test:dice": "node test/e2e/dice.mjs",
    "test:t3d": "node test/e2e/t3d.mjs"
  },
  "engines": {
    "node": ">=22.8"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cannon-es": "^0.20.0",
    "eslint": "^9.39.5",
    "playwright": "^1.49.0",
    "three": "^0.170.0"
  }
}
